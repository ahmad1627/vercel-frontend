{
  "name": "pak-triseries-fantasy-2026",
  "version": "3.1.0",
  "description": "2026 Pakistan ODI Tri-Nation Series Daily Fantasy Web Application (Node.js + React on Vercel)",
  "main": "api/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:frontend && node -e \"require('fs').cpSync('frontend/dist','dist',{recursive:true})\"",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "node backend/test_node_suite.js",
    "test:persistence": "node backend/test_persistence_suite.js",
    "vercel-build": "npm run build:frontend && node -e \"require('fs').cpSync('frontend/dist','dist',{recursive:true})\"",
    "test": "npm run test:backend && npm run test:persistence && npm run test:production && npm run test:frontend",
    "setup:local": "node scripts/setup-local.js",
    "test:production": "node backend/test_production_suite.js",
    "test:frontend": "npm --prefix frontend test"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
