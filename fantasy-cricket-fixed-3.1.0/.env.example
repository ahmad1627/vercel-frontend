# LOCAL ONLY: copy this file to .env and fill in your own values.
# On Vercel, add these in Project Settings > Environment Variables instead.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=replace-with-your-own-strong-password
# Leave these empty locally to use the new api/data/ind-nz-odi.json state file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# New competition namespace. Usually leave unset to use the India–New Zealand default.
# Legacy Pakistan tri-series account migration source (read-only during first startup):
# LEGACY_GAME_NAMESPACE=fantasy-cricket:tri-series:2026
# LEGACY_LOCAL_DATA_FILE=api/data/game.json
# GAME_NAMESPACE=fantasy-cricket:ind-nz-odi:2026
